# Copy to .env and fill in. chmod 600 .env
BOT_TOKEN=123456:ABC-your-bot-token
# Same channel with two topic threads (forum supergroup with Topics enabled),
# or two different channel IDs — both layouts work.
GALLERY_CHAT_ID=-1002292128611
GALLERY_THREAD_ID=2
ARCHIVE_CHAT_ID=-1002292128611
ARCHIVE_THREAD_ID=3

# Parent library dir (multi-user) — bot auto-discovers user subdirs.
LIBRARY_ROOT=/Volumes/ExFAT/immich-data/library

# Local timezone used to resolve --today
TZ=Asia/Singapore

# Zip is sent whole unless it exceeds this (MB). 1900 ≈ single file up to ~2GB.
# NOTE: Telegram's official Bot API rejects bot uploads over ~50MB, so a zip
# between 50MB and SPLIT_MB is auto re-split into FALLBACK_SPLIT_MB parts.
# (Self-host a local Bot API server to lift the cap to 2GB.)
SPLIT_MB=1900
FALLBACK_SPLIT_MB=45

# Archive sender: auto = Bot API up to USERBOT_THRESHOLD_MB, then userbot
# (your Telegram account via MTProto, up to 2GB whole). bot = Bot API only,
# userbot = always your account. Overridable per-run with --archive-via.
ARCHIVE_VIA=auto
USERBOT_THRESHOLD_MB=50

# Map friendly names to library dir names. Discover names via: bot.py --list-users
# Example: USER_ALIASES="tony:373b4d5c-77f3-41e6-9dd0-e87e8b476554,ninnette:admin"
USER_ALIASES=tony:373b4d5c-77f3-41e6-9dd0-e87e8b476554,ninnette:admin

STATE_FILE=/Users/tonyngmk/immich-telegram-bot/state.json

# --- Userbot (MTProto) test: bypasses the 50MB Bot API cap (2GB as a user) ---
# Get these at https://my.telegram.org/apps . Only needed for userbot_test.py.
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789
PHONE_NUMBER=+6591234567
